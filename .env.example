# --- required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- agent behaviour ---
MODEL=claude-sonnet-5-5
REPO_ROOT=demo-java-app          # path to the Java repo the agent fixes
BASE_BRANCH=main
FINDINGS_SOURCE=file             # file | sonar | codeql
MIN_SEVERITY=MAJOR               # INFO | MINOR | MAJOR | CRITICAL | BLOCKER
MAX_FINDINGS=5
MAX_ATTEMPTS=3                   # build-fix retries per finding
DRY_RUN=true                     # true = commit locally only, never push or open PRs
MAVEN_CMD=mvn
BUILD_TIMEOUT_SEC=900

# --- FINDINGS_SOURCE=sonar ---
SONAR_URL=https://sonarqube.example.com
SONAR_PROJECT_KEY=claims-service
SONAR_TOKEN=

# --- FINDINGS_SOURCE=codeql, and for opening PRs (gh CLI uses GH_TOKEN/GITHUB_TOKEN) ---
GITHUB_REPO=your-org/claims-service
GITHUB_TOKEN=
